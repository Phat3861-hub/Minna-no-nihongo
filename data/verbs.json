{
  "_ghi_chu": "Nhóm động từ. group: 1, 2 hoặc 3. forms: dict = thể từ điển, te = thể て, nai = thể ない, ta = thể た. exception = ghi chú khi động từ là ngoại lệ.",
  "groups": [
    {
      "group": 1,
      "name": "Nhóm I",
      "alias": "五段動詞 (ごだんどうし)",
      "rule": "Âm đứng ngay trước ます thuộc hàng い (い, き, ぎ, し, ち, に, び, み, り).",
      "examples": ["かきます", "のみます", "かえります", "あそびます", "かいます"]
    },
    {
      "group": 2,
      "name": "Nhóm II",
      "alias": "一段動詞 (いちだんどうし)",
      "rule": "Âm đứng ngay trước ます thuộc hàng え (え, け, せ, て, ね, べ, め, れ…). Ngoài ra có một số động từ đặc biệt có âm hàng い nhưng vẫn thuộc nhóm II.",
      "examples": ["たべます", "ねます", "おしえます", "みます", "おきます"]
    },
    {
      "group": 3,
      "name": "Nhóm III",
      "alias": "不規則動詞 (ふきそくどうし)",
      "rule": "Chỉ có します, きます (来ます, đến) và các động từ dạng Danh từ + します.",
      "examples": ["します", "きます", "べんきょうします", "けっこんします"]
    }
  ],
  "exceptionsGroup2": {
    "note": "Các động từ có âm hàng い trước ます nhưng thuộc nhóm II. Cần học thuộc.",
    "inLessons": ["みます (見ます)", "おきます (起きます)", "かります (借ります)", "います"],
    "later": ["あびます (浴びます)", "おります (降ります)", "できます", "きます (着ます, mặc)"]
  },
  "forms": [
    {
      "key": "te",
      "name": "Thể て",
      "lesson": 14,
      "use": "Dùng cho ～てください (Bài 14), ～ています (Bài 14–15), ～てもいいです (Bài 15)…",
      "rules": [
        { "group": 1, "items": [
          "い, ち, り + ます → って: かいます → かって, まちます → まって, かえります → かえって",
          "み, び, に + ます → んで: のみます → のんで, あそびます → あそんで, しにます → しんで",
          "き + ます → いて: かきます → かいて",
          "ぎ + ます → いで: およぎます → およいで",
          "し + ます → して: かします → かして",
          "Ngoại lệ: いきます (行きます) → いって"
        ] },
        { "group": 2, "items": ["Bỏ ます, thêm て: たべます → たべて, みます → みて"] },
        { "group": 3, "items": ["します → して", "きます → きて", "べんきょうします → べんきょうして"] }
      ]
    },
    {
      "key": "nai",
      "name": "Thể ない",
      "lesson": 17,
      "use": "Dùng cho ～ないでください, ～なければなりません, ～なくてもいいです (Bài 17).",
      "rules": [
        { "group": 1, "items": [
          "Đổi âm hàng い trước ます sang hàng あ rồi thêm ない: かきます → かかない, のみます → のまない",
          "Âm い đổi thành わ (không phải あ): かいます → かわない, あいます → あわない",
          "Ngoại lệ: あります → ない"
        ] },
        { "group": 2, "items": ["Bỏ ます, thêm ない: たべます → たべない, みます → みない"] },
        { "group": 3, "items": ["します → しない", "きます → こない"] }
      ]
    },
    {
      "key": "dict",
      "name": "Thể từ điển",
      "lesson": 18,
      "use": "Dùng cho ～ことができます, ～ことです (Bài 18), ～まえに (Bài 18)…",
      "rules": [
        { "group": 1, "items": [
          "Đổi âm hàng い trước ます sang hàng う: かきます → かく, のみます → のむ, かえります → かえる"
        ] },
        { "group": 2, "items": ["Bỏ ます, thêm る: たべます → たべる, みます → みる"] },
        { "group": 3, "items": ["します → する", "きます → くる"] }
      ]
    },
    {
      "key": "ta",
      "name": "Thể た",
      "lesson": 19,
      "use": "Dùng cho ～たことがあります, ～たり～たりします (Bài 19). Cách chia giống thể て, chỉ đổi て → た, で → だ.",
      "rules": [
        { "group": 1, "items": [
          "Giống thể て: かいて → かいた, のんで → のんだ, かって → かった",
          "Ngoại lệ: いきます → いった"
        ] },
        { "group": 2, "items": ["Bỏ ます, thêm た: たべます → たべた"] },
        { "group": 3, "items": ["します → した", "きます → きた"] }
      ]
    }
  ],
  "tips": [
    "Luôn xác định nhóm từ thể ます: nhìn âm ngay trước ます.",
    "Cẩn thận với các động từ nhóm I có thể từ điển kết thúc bằng える／いる như かえる (về), きる (cắt), はいる (vào): chúng vẫn là nhóm I vì thể ます là かえります, きります, はいります.",
    "Khi học từ mới là động từ, hãy học luôn nhóm của nó."
